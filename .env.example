# ───────────────────────── Core ─────────────────────────
SITE_URL=https://consulting.example.com
# 32+ random chars. Signs private scheduling/proposal links. Rotating it invalidates all outstanding links.
TOKEN_SECRET=
# 32+ random chars. Signs dashboard sessions.
SESSION_SECRET=
# Dashboard passwords (Tim sees his two dashboards + the staff console; staff sees the staff console only).
TIM_DASHBOARD_PASSWORD=
STAFF_DASHBOARD_PASSWORD=
# Bearer secret for GET /api/cron/sweep (Vercel Cron sends it automatically when set).
CRON_SECRET=
# Time zone used in client emails.
DISPLAY_TIME_ZONE=America/Chicago

# ───────────────────────── Tape (CRM of record) ─────────────────────────
# "tape" in production. "memory" is for local development only.
CRM_DRIVER=tape
# Scoped personal access token for an integration user. Server-side only — never NEXT_PUBLIC_.
TAPE_API_KEY=
TAPE_API_BASE_URL=https://api.tapeapp.com/v1
# bearer | basic (basic = API key as username). Use whichever Tape's docs specify for your key type.
TAPE_AUTH_SCHEME=bearer
TAPE_CONTACTS_APP_ID=
TAPE_REQUESTS_APP_ID=
TAPE_MATTERS_APP_ID=
# Optional: app for matter tasks. If unset, tasks are not created in Tape.
TAPE_TASKS_APP_ID=
# Shared secret appended to the Tape workflow webhook URL: /api/webhooks/tape?secret=...
TAPE_WEBHOOK_SECRET=

# Local development only:
# MEMORY_STORE_FILE=.data/dev-store.json

# ───────────────────────── Notifications ─────────────────────────
EMAIL_DRIVER=resend
EMAIL_FROM="Tim Berry Consulting <consulting@example.com>"
RESEND_API_KEY=
TIM_NOTIFY_EMAIL=tim@example.com
# Comma-separated (e.g. Kevin + intake staff)
STAFF_NOTIFY_EMAILS=kevin@example.com
# twilio | console | off
SMS_DRIVER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ───────────────────────── Scheduling ─────────────────────────
# calendly | mock (mock = built-in slot picker for local dev)
SCHEDULING_DRIVER=calendly
CALENDLY_API_TOKEN=
# URI of the ONE secret event type "Tim Berry Discovery Call - 15 Minutes", e.g. https://api.calendly.com/event_types/XXXX
CALENDLY_DISCOVERY_EVENT_TYPE_URI=
CALENDLY_WEBHOOK_SIGNING_KEY=
DISCOVERY_CALL_MINUTES=15

# ───────────────────────── Recording / transcripts ─────────────────────────
# HMAC secret for the provider-neutral /api/webhooks/transcript endpoint.
TRANSCRIPT_WEBHOOK_SECRET=
# Zoom app "Secret Token" for /api/webhooks/zoom.
ZOOM_WEBHOOK_SECRET_TOKEN=
TRANSCRIPT_OVERDUE_HOURS=4

# AI draft summary. Leave false until the provider/account is approved for confidential client information.
AI_SUMMARY_ENABLED=false
ANTHROPIC_API_KEY=
AI_SUMMARY_MODEL=claude-opus-5

# ───────────────────────── Stripe ─────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ───────────────────────── Engagement rules ─────────────────────────
# Require e-signature of the engagement agreement before payment / matter opening.
ENGAGEMENT_AGREEMENT_REQUIRED=true
# Default for "initial documents must be received before the matter opens" (staff can change per request).
INITIAL_DOCUMENTS_REQUIRED_DEFAULT=false
# One automatic reminder each; 0 disables.
SCHEDULING_REMINDER_DAYS=3
PROPOSAL_REMINDER_DAYS=3
